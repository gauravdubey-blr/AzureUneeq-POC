# AzureUneeq POC — environment template
# Copy to .env and fill in. .env is gitignored; never commit real keys.
#   cp .env.example .env

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ─── Voice instance (voice input + voice output) ──────────────────────────────
# Single source of truth for the Azure resource serving voice, resolved in
# config/voiceInstance.js and used by:
#   POST /api/voice/transcribe   (voice input  — STT)
#   POST /api/voice/speak        (voice output — TTS)
#   POST /api/voice/converse     (transcribe → model → speak)
#   POST /api/text-to-speech     (legacy, same services)
#   POST /api/speech-to-text     (legacy, same services)
#
# Each var falls back to the legacy name beside it, so leaving these empty keeps
# the app on its current endpoints. Confirm what resolved with
# GET /api/voice/config or GET /health — neither exposes the key.

AZURE_VOICE_REGION=eastus2          # ← falls back to AZURE_SPEECH_REGION
AZURE_VOICE_KEY=                    # ← falls back to AZURE_SUBSCRIPTION_KEY
AZURE_VOICE_TTS_VOICE=en-US-AriaNeural
AZURE_VOICE_STT_LOCALE=en-US

# Endpoint shape:
#   cognitive  {region}.api.cognitive.microsoft.com/stt|tts/...  (default; what
#              the endpoints were hard-coded to before this change)
#   speech     {region}.stt|tts.speech.microsoft.com/...         (MS standard)
#   apim       {AZURE_VOICE_BASE_URL}/stt|tts/...                (Lilly gateway)
AZURE_VOICE_MODE=cognitive
# AZURE_VOICE_BASE_URL=https://gateway.apim-dev.lilly.com/bu-aidigassist

# Full-URL overrides — for private endpoints or any shape the modes don't cover.
# AZURE_VOICE_STT_URL=
# AZURE_VOICE_TTS_URL=

# 'key' sends Ocp-Apim-Subscription-Key (default).
# 'bearer' sends an AAD token from azureAuthService — use when going via APIM.
AZURE_VOICE_AUTH_MODE=key
# AZURE_VOICE_TTS_RESOURCE_KEY=      # x-tts-resource-key, APIM routing only

# Default output format: pcm16 | pcm24 | wav | mp3 | mp3hq | raw24
# pcm16 matches what the legacy /api/text-to-speech route always returned.
AZURE_VOICE_TTS_FORMAT=pcm16

# Request caps
VOICE_MAX_AUDIO_BYTES=26214400      # 25 MB inbound audio
VOICE_MAX_TTS_CHARS=5000            # text cap on synthesis
VOICE_TIMEOUT_MS=30000

# ─── Legacy voice vars (still read as fallbacks) ──────────────────────────────
AZURE_SUBSCRIPTION_KEY=
AZURE_OUTPUT_FORMAT=

# ─── Azure AD (MSAL) — required, app exits if missing ─────────────────────────
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=

# ─── LLM Gateway ──────────────────────────────────────────────────────────────
LLM_CLIENT_ID=
LLM_CLIENT_SECRET=
LLM_TENANT_ID=
LLM_GATEWAY_KEY=
LLM_MODEL=gpt-4o
LLM_GATEWAY_BASE_URL=https://gateway.apim-dev.lilly.com/llm-gateway/
LLM_TOKEN_URL=
LLM_SCOPE=api://llm-gateway.lilly.com/.default

# ─── Cortex ───────────────────────────────────────────────────────────────────
CORTEX_CLIENT_ID=
CORTEX_CLIENT_SECRET=
CORTEX_TENANT_ID=
CORTEX_BASE_URL=https://api.cortex.lilly.com
CORTEX_SCOPE=api://cortex.lilly.com/.default
CORTEX_TOKEN_URL=

# ─── Local development escape hatch ───────────────────────────────────────────
# Disables TLS certificate verification PROCESS-WIDE. Only for local dev behind
# a corporate proxy with a self-signed cert. Ignored when NODE_ENV=production.
# ALLOW_INSECURE_TLS=false
